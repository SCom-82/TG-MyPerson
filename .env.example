# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/tg_myperson

# Telegram API credentials (from https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# [DEPRECATED] Phone number for first-time Telegram login via legacy singleton path.
# Not used after multi-account refactor (Phase 1-4). Session bootstrap now goes via:
#   POST /api/v1/accounts  →  POST /auth/login?session=<alias>  →  POST /auth/code?session=<alias>
# Kept for backward compatibility — pydantic-settings ignores unknown vars in the env file.
TG_PHONE_NUMBER=+79001234567

# [DEPRECATED] Session string for the legacy tg_session singleton store.
# Not used after multi-account refactor (Phase 1-4). The tg_session table was dropped
# in migration 004. Sessions are now stored in account_sessions (accounts table).
# Kept for backward compatibility with existing deployments that already have this set.
TG_SESSION_STRING=

# REQUIRED in production. If empty, X-API-Key authentication is DISABLED
# (all routes accept requests without the header). Acceptable only for local dev.
API_KEY=

# REQUIRED for /api/v1/accounts/* endpoints. If empty, all admin endpoints return 503 (misconfigured).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TG_ADMIN_API_KEY=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# User timezone (IANA format)
USER_TIMEZONE=Europe/Samara

# --- MAX platform (see README «Платформа MAX») ---
# Start the MAX pool. false = MAX code is loaded but no MAX session is started.
MAX_ENABLED=false
# All MAX traffic (WebSocket/TCP + media). Prod: socks5://max-egress:1080
MAX_PROXY_URL=
# Fail-closed: without MAX_PROXY_URL a MAX session does not start.
MAX_REQUIRE_PROXY=true
# Gap catch-up: seed size for a never-seen chat, chats per pass
MAX_CATCHUP_SEED=50
MAX_CATCHUP_MAX_CHATS=60
# Retention of the raw frame journal max_raw_events
MAX_RAW_EVENTS_RETENTION_DAYS=30
# Phase 2 (writes): sends per hour when accounts.write_rate_per_hour is NULL
MAX_WRITE_RATE_DEFAULT=20
